# Home / bootstrap seed node (always-on, e.g. Kortrijk laptop)
# Start with: npm run build && npm run start:home
# Defaults: TCP 4001 and WebSocket 4002 (usable as published bootstrap ports)

PORT=4001
WS_PORT=4002
# Optional full listen override (comma-separated). Takes precedence over PORT / WS_PORT.
# LISTEN_ADDRS=/ip4/0.0.0.0/tcp/4001,/ip4/0.0.0.0/tcp/4002/ws

# Host other nodes should dial. 0.0.0.0 is not a usable bootstrap address.
# Set this to the LAN or public IP before publishing BOOTSTRAP_PEERS.
# ANNOUNCE_HOST=192.168.1.10

ENABLE_WEBRTC=true
# ENABLE_WS=true

# Application / peer identity (hex PKCS8 Ed25519 private key).
# Prefer leaving PRIVATE_KEY unset on the home node: a key is generated once
# and reused from DAUP_PEER_KEY_FILE (default .daup/peer.key). Never commit it.
# PRIVATE_KEY=302e020100300506032b657004220420...
DAUP_PEER_KEY_FILE=.daup/peer.key

# Other nodes (comma-separated multiaddrs including /p2p/<PeerId>).
# Leave empty on the first home / seed node. Copy the start banner output here
# on light peers.
BOOTSTRAP_PEERS=
